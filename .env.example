# ── UW dining (public, read-only) ──────────────────────────────────
NEXT_PUBLIC_DINING_API_KEY=
NEXT_PUBLIC_DINING_AUTH_DOMAIN=
NEXT_PUBLIC_DINING_DB_URL=
NEXT_PUBLIC_DINING_PROJECT_ID=
NEXT_PUBLIC_DINING_APP_ID=

# ── Meal scanner ────────────────────────────────────────────────────
# Set to "true" to show the camera/scan entry points in the app.
NEXT_PUBLIC_SCAN_ENABLED=false

# PRIMARY vision: each user's own Cohere key (Command A Vision) is used first,
# so users don't pay out of pocket. No server env needed for this — it's the
# same key they set in Profile → AI key for chat/planner.
# COHERE_VISION_MODEL=command-a-vision-07-2025   # optional override

# FALLBACK vision provider (server-side), used only when a user has no Cohere
# key or Cohere fails. Pick a FREE provider. VISION_PROVIDER: groq | gemini | claude | none
VISION_PROVIDER=groq

# Groq — free, generous tier. Key from https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Gemini (free tier is rate-limited) — only if VISION_PROVIDER=gemini
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# Claude — only if VISION_PROVIDER=claude
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-4-8

# USDA FoodData Central — free key from https://fdc.nal.usda.gov/api-key-signup
# Grounds generic-food macro estimates and powers manual search. Optional but recommended.
FDC_API_KEY=

# Open Food Facts (barcodes / packaged foods) needs no key.
